{
  "name": "kid-a",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('node:fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "build:gh-pages": "npm run build",
    "build:netlify": "VITE_DATA_LAYER=remote VITE_BASE_PATH=/ npm run build && npm run build:server",
    "build:node": "VITE_DATA_LAYER=remote VITE_BASE_PATH=/ npm run build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:node": "node dist-server/server/index.js"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "@primer/octicons-react": "^19.28.1",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  }
}
